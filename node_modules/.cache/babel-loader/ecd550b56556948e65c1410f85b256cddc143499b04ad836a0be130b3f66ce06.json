{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { obtenerLibroPorId, eliminarLibro } from '../store/libros.js';\n\n// \"id\" llega como prop gracias a props:true en el router\n// (ruta definida como '/libros/:id')\n\nexport default {\n  __name: 'DetalleLibro',\n  props: {\n    id: {\n      type: [String, Number],\n      required: true\n    }\n  },\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const props = __props;\n    const router = useRouter();\n    const libro = computed(() => obtenerLibroPorId(props.id));\n    function eliminar() {\n      eliminarLibro(libro.value.id);\n      router.push('/libros');\n    }\n    const __returned__ = {\n      props,\n      router,\n      libro,\n      eliminar,\n      computed,\n      get useRouter() {\n        return useRouter;\n      },\n      get obtenerLibroPorId() {\n        return obtenerLibroPorId;\n      },\n      get eliminarLibro() {\n        return eliminarLibro;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["computed","useRouter","obtenerLibroPorId","eliminarLibro","props","__props","router","libro","id","eliminar","value","push"],"sources":["/Users/kathering/Documents/PROYECTO 6/src/views/DetalleLibro.vue"],"sourcesContent":["<template>\n  <section class=\"detalle-libro\">\n    <RouterLink to=\"/libros\" class=\"volver\">← Volver al catálogo</RouterLink>\n\n    <div v-if=\"libro\">\n      <h1>{{ libro.titulo }}</h1>\n      <p class=\"autor\">{{ libro.autor }}</p>\n      <span class=\"categoria\">{{ libro.categoria }}</span>\n      <p class=\"descripcion\">\n        {{ libro.descripcion || 'Este libro no tiene descripción registrada.' }}\n      </p>\n\n      <button class=\"btn-eliminar\" @click=\"eliminar\">\n        Eliminar este libro\n      </button>\n    </div>\n\n    <p v-else class=\"no-encontrado\">\n      No se encontró ningún libro con el id \"{{ id }}\".\n    </p>\n  </section>\n</template>\n\n<script setup>\nimport { computed } from 'vue'\nimport { useRouter } from 'vue-router'\nimport { obtenerLibroPorId, eliminarLibro } from '../store/libros.js'\n\n// \"id\" llega como prop gracias a props:true en el router\n// (ruta definida como '/libros/:id')\nconst props = defineProps({\n  id: {\n    type: [String, Number],\n    required: true\n  }\n})\n\nconst router = useRouter()\n\nconst libro = computed(() => obtenerLibroPorId(props.id))\n\nfunction eliminar() {\n  eliminarLibro(libro.value.id)\n  router.push('/libros')\n}\n</script>\n\n<style scoped>\n.detalle-libro { font-family: sans-serif; }\n.volver {\n  display: inline-block;\n  margin-bottom: 1.2rem;\n  color: var(--acento);\n  text-decoration: none;\n  font-size: 0.9rem;\n}\n.volver:hover { color: var(--acento-oscuro); }\n.detalle-libro h1 { font-family: 'Georgia', serif; margin-bottom: 0.2rem; color: var(--tinta); }\n.autor { color: var(--texto-suave); margin: 0 0 0.4rem; }\n.categoria {\n  display: inline-block;\n  font-size: 0.75rem;\n  color: var(--acento-oscuro);\n  background: var(--acento-suave);\n  border: 1px solid var(--linea);\n  border-radius: 999px;\n  padding: 0.1rem 0.6rem;\n  margin-bottom: 1rem;\n}\n.descripcion { line-height: 1.6; color: var(--tinta); max-width: 60ch; }\n.btn-eliminar {\n  margin-top: 1rem;\n  padding: 0.5rem 1rem;\n  border: 1px solid var(--linea);\n  border-radius: 6px;\n  background: #fff;\n  color: #c2410c;\n  cursor: pointer;\n}\n.btn-eliminar:hover { background: #fef2f2; border-color: #fca5a5; color: #b91c1c; }\n.no-encontrado { color: var(--texto-suave); font-style: italic; }\n</style>\n"],"mappings":";AAwBA,SAASA,QAAQ,QAAQ,KAAI;AAC7B,SAASC,SAAS,QAAQ,YAAW;AACrC,SAASC,iBAAiB,EAAEC,aAAa,QAAQ,oBAAmB;;AAEpE;AACA;;;;;;;;;;;;;;IACA,MAAMC,KAAK,GAAGC,OAAA;IAOd,MAAMC,MAAM,GAAGL,SAAS,CAAC;IAEzB,MAAMM,KAAK,GAAGP,QA