{"ast":null,"code":"import { ref } from 'vue';\n\n// \"ref\" crea el dato reactivo (Modelo). La plantilla (Vista) se\n// actualiza sola cuando cambia su valor: esto es el patrón MVVM.\n\nexport default {\n  __name: 'App',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const nombreUsuario = ref('Francisco');\n    const contador = ref(0);\n    function incrementar() {\n      contador.value++;\n    }\n    const __returned__ = {\n      nombreUsuario,\n      contador,\n      incrementar,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","nombreUsuario","contador","incrementar","value"],"sources":["/Users/kathering/Documents/PROYECTO 6/src/App.vue"],"sourcesContent":["<template>\n  <div class=\"app\">\n    <header class=\"app-header\">\n      <div class=\"marca\">\n        <span class=\"marca-texto\">BookList</span>\n      </div>\n\n      <nav class=\"app-nav\">\n        <RouterLink to=\"/\">Inicio</RouterLink>\n        <RouterLink to=\"/libros\">Catálogo</RouterLink>\n      </nav>\n\n      <!-- Lección 1: datos reactivos + método + patrón MVVM -->\n      <div class=\"visitas\">\n        <span>Hola, {{ nombreUsuario }} · Visitas a este panel: {{ contador }}</span>\n        <button @click=\"incrementar\">+1</button>\n      </div>\n    </header>\n\n    <main class=\"app-main\">\n      <!-- RouterView renderiza la vista activa según la ruta -->\n      <RouterView />\n    </main>\n\n    <footer class=\"app-footer\">\n      Editorial Nova · Boocklist\n    </footer>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\n\n// \"ref\" crea el dato reactivo (Modelo). La plantilla (Vista) se\n// actualiza sola cuando cambia su valor: esto es el patrón MVVM.\nconst nombreUsuario = ref('Francisco')\nconst contador = ref(0)\n\nfunction incrementar() {\n  contador.value++\n}\n</script>\n\n<style>\n:root {\n  --tinta: #12213a;\n  --papel: #ffffff;\n  --panel: #ffffff;\n  --acento: #2563eb;\n  --acento-oscuro: #1d4ed8;\n  --acento-suave: #dbeafe;\n  --linea: #bfdbfe;\n  --texto-suave: #4b6a95;\n  --novela: #eb8125;\n  --fantasia: #9feb25;\n  --ciencia-ficcion: #ebd425;\n  --poesia: #eb25de;\n  --ensayo: #25caeb; \n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font-family: 'Georgia', 'Times New Roman', serif;\n  background: var(--papel);\n  color: var(--tinta);\n}\n\n.app-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 1rem;\n  padding: 1rem 2rem;\n  background: var(--acento);\n}\n\n.marca { font-size: 1.4rem; display: flex; align-items: center; gap: 0.5rem; color: #fff; }\n.marca em { font-style: italic; color: #fff; }\n\n.app-nav { display: flex; gap: 1.2rem; }\n.app-nav a {\n  color: rgba(255, 255, 255, 0.85);\n  text-decoration: none;\n  padding-bottom: 3px;\n  border-bottom: 2px solid transparent;\n  font-family: sans-serif;\n  font-size: 0.95rem;\n}\n.app-nav a.router-link-exact-active {\n  border-bottom-color: #fff;\n  color: #fff;\n}\n\n.visitas {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  font-family: sans-serif;\n  font-size: 0.85rem;\n  color: rgba(255, 255, 255, 0.85);\n}\n.visitas button {\n  border: 1px solid rgba(255, 255, 255, 0.6);\n  background: transparent;\n  color: #fff;\n  border-radius: 4px;\n  padding: 0.2rem 0.6rem;\n  cursor: pointer;\n}\n.visitas button:hover { background: rgba(255, 255, 255, 0.15); }\n\n.app-main { padding: 2rem; max-width: 900px; margin: 0 auto; }\n\n.app-footer {\n  text-align: center;\n  padding: 1.2rem;\n  font-family: sans-serif;\n  font-size: 0.8rem;\n  color: var(--texto-suave);\n  border-top: 1px solid var(--linea);\n}\n</style>\n"],"mappings":"AA+BA,SAASA,GAAG,QAAQ,KAAI;;AAExB;AACA;;;;;;;;IACA,MAAMC,aAAa,GAAGD,GAAG,CAAC,WAAW;IACrC,MAAME,QAAQ,GAAGF,GAAG,CAAC,CAAC;IAEtB,SAASG,WAAWA,CAAA,EAAG;MACrBD,QAAQ,CAACE,KAAK,EAAC;IACjB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}