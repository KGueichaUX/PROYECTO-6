{"ast":null,"code":"export default {\n  __name: 'Libro',\n  props: {\n    libro: {\n      type: Object,\n      required: true\n    }\n  },\n  emits: ['eliminar'],\n  setup(__props, {\n    expose: __expose,\n    emit: __emit\n  }) {\n    __expose();\n\n    // defineProps y defineEmits son macros de compilador: no requieren import.\n    const props = __props;\n    const emit = __emit;\n    function confirmarEliminar() {\n      // El componente hijo no borra el dato directamente:\n      // emite el evento y deja que el padre (dueño del estado) decida.\n      emit('eliminar', props.libro.id);\n    }\n    const __returned__ = {\n      props,\n      emit,\n      confirmarEliminar\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["props","__props","emit","__emit","confirmarEliminar","libro","id"],"sources":["/Users/kathering/Documents/PROYECTO 6/src/components/Libro.vue"],"sourcesContent":["<template>\n  <!-- v-bind:class se usa aquí de forma abreviada como :class -->\n  <article class=\"libro-card\" :class=\"{ 'libro-card--fantasia': libro.categoria === 'Fantasía' }\">\n    <div class=\"libro-info\">\n      <!-- v-bind:title crea un atributo HTML nativo con el nombre completo -->\n      <h3 :title=\"libro.titulo\">{{ libro.titulo }}</h3>\n      <p class=\"libro-autor\">{{ libro.autor }}</p>\n      <span class=\"libro-categoria\">{{ libro.categoria }}</span>\n    </div>\n\n    <div class=\"libro-acciones\">\n      <!-- Ruta dinámica: /libros/:id -->\n      <RouterLink :to=\"`/libros/${libro.id}`\" class=\"btn-detalle\">Ver detalle</RouterLink>\n\n      <!-- Lección 4: evento @click con modificador .once -->\n      <button class=\"btn-eliminar\" @click.once=\"confirmarEliminar\">\n        Eliminar\n      </button>\n    </div>\n  </article>\n</template>\n\n<script setup>\n// defineProps y defineEmits son macros de compilador: no requieren import.\nconst props = defineProps({\n  libro: {\n    type: Object,\n    required: true\n  }\n})\n\nconst emit = defineEmits(['eliminar'])\n\nfunction confirmarEliminar() {\n  // El componente hijo no borra el dato directamente:\n  // emite el evento y deja que el padre (dueño del estado) decida.\n  emit('eliminar', props.libro.id)\n}\n</script>\n\n<style scoped>\n.libro-card {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 1rem;\n  padding: 1rem;\n  border: 1px solid var(--linea);\n  border-radius: 8px;\n  background: var(--panel);\n  margin-bottom: 0.8rem;\n}\n.libro-card--fantasia { border-left: 4px solid var(--acento); }\n.libro-info h3 { margin: 0 0 0.2rem; font-size: 1.05rem; }\n.libro-autor { margin: 0; color: var(--texto-suave); font-size: 0.9rem; font-family: sans-serif; }\n.libro-categoria {\n  display: inline-block;\n  margin-top: 0.3rem;\n  font-size: 0.75rem;\n  font-family: sans-serif;\n  color: var(--acento-oscuro);\n  background: var(--acento-suave);\n  border: 1px solid var(--linea);\n  border-radius: 999px;\n  padding: 0.1rem 0.6rem;\n}\n.libro-acciones { display: flex; gap: 0.5rem; flex-shrink: 0; }\n.btn-detalle, .btn-eliminar {\n  font-family: sans-serif;\n  font-size: 0.85rem;\n  padding: 0.4rem 0.8rem;\n  border-radius: 6px;\n  cursor: pointer;\n  text-decoration: none;\n  border: 1px solid var(--linea);\n}\n.btn-detalle { background: var(--acento); color: #fff; border-color: var(--acento); }\n.btn-detalle:hover { background: var(--acento-oscuro); }\n.btn-eliminar { background: #fff; color: #e0263f; }\n.btn-eliminar:hover { background: #fef2f2; border-color: #fca5a5; color: #b91c1c; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;IAuBA;IACA,MAAMA,KAAK,GAAGC,OAAA;IAOd,MAAMC,IAAI,GAAGC,MAAA;IAEb,SAASC,iBAAiBA,CAAA,EAAG;MAC3B;MACA;MACAF,IAAI,CAAC,UAAU,EAAEF,KAAK,CAACK,KAAK,CAACC,EAAE;IACjC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}