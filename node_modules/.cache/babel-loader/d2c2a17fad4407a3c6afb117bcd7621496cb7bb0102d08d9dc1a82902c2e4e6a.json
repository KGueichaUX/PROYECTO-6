{"ast":null,"code":"import { reactive, computed } from 'vue';\nexport default {\n  __name: 'FormularioLibro',\n  emits: ['agregar-libro'],\n  setup(__props, {\n    expose: __expose,\n    emit: __emit\n  }) {\n    __expose();\n    const emit = __emit;\n\n    // Modelo del formulario: cada campo está vinculado con v-model\n    const nuevoLibro = reactive({\n      titulo: '',\n      autor: '',\n      categoria: '',\n      descripcion: ''\n    });\n    const formularioValido = computed(() => {\n      return nuevoLibro.titulo.trim() !== '' && nuevoLibro.autor.trim() !== '';\n    });\n    function enviar() {\n      if (!formularioValido.value) return;\n      emit('agregar-libro', {\n        ...nuevoLibro\n      });\n\n      // Limpiar el formulario tras enviar\n      Object.assign(nuevoLibro, {\n        titulo: '',\n        autor: '',\n        categoria: '',\n        descripcion: ''\n      });\n    }\n    const __returned__ = {\n      emit,\n      nuevoLibro,\n      formularioValido,\n      enviar,\n      reactive,\n      computed\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","computed","emit","__emit","nuevoLibro","titulo","autor","categoria","descripcion","formularioValido","trim","enviar","value","Object","assign"],"sources":["/Users/kathering/Documents/PROYECTO 6/src/components/FormularioLibro.vue"],"sourcesContent":["<template>\n  <!-- @submit.prevent evita que el navegador recargue la página al enviar -->\n  <form class=\"formulario\" @submit.prevent=\"enviar\">\n    <div class=\"campo\">\n      <label for=\"titulo\">Título</label>\n      <input\n        id=\"titulo\"\n        v-model=\"nuevoLibro.titulo\"\n        type=\"text\"\n        placeholder=\"Ej: El Principito\"\n        @keyup.enter=\"enviar\"\n      />\n    </div>\n\n    <div class=\"campo\">\n      <label for=\"autor\">Autor</label>\n      <input\n        id=\"autor\"\n        v-model=\"nuevoLibro.autor\"\n        type=\"text\"\n        placeholder=\"Ej: Julio Cortázar\"\n        @keyup.enter=\"enviar\"\n      />\n    </div>\n\n    <div class=\"campo\">\n      <label for=\"categoria\">Categoría</label>\n      <select id=\"categoria\" v-model=\"nuevoLibro.categoria\">\n        <option disabled value=\"\">Selecciona una categoría</option>\n        <option>Novela</option>\n        <option>Fantasía</option>\n        <option>Ciencia ficción</option>\n        <option>Poesía</option>\n        <option>Ensayo</option>\n      </select>\n    </div>\n\n    <div class=\"campo\">\n      <label for=\"descripcion\">Descripción</label>\n      <textarea\n        id=\"descripcion\"\n        v-model=\"nuevoLibro.descripcion\"\n        rows=\"3\"\n        placeholder=\"Breve sinopsis del libro\"\n      ></textarea>\n    </div>\n\n    <!-- Vista previa en tiempo real: demuestra la reactividad de v-model -->\n    <p class=\"previa\" v-if=\"nuevoLibro.titulo || nuevoLibro.autor\">\n      Vista previa: <strong>{{ nuevoLibro.titulo || '(sin título)' }}</strong>\n      — {{ nuevoLibro.autor || '(sin autor)' }}\n      <span v-if=\"nuevoLibro.categoria\"> · {{ nuevoLibro.categoria }}</span>\n    </p>\n\n    <button type=\"submit\" class=\"btn-agregar\" :disabled=\"!formularioValido\">\n      Añadir libro\n    </button>\n  </form>\n</template>\n\n<script setup>\nimport { reactive, computed } from 'vue'\n\nconst emit = defineEmits(['agregar-libro'])\n\n// Modelo del formulario: cada campo está vinculado con v-model\nconst nuevoLibro = reactive({\n  titulo: '',\n  autor: '',\n  categoria: '',\n  descripcion: ''\n})\n\nconst formularioValido = computed(() => {\n  return nuevoLibro.titulo.trim() !== '' && nuevoLibro.autor.trim() !== ''\n})\n\nfunction enviar() {\n  if (!formularioValido.value) return\n\n  emit('agregar-libro', { ...nuevoLibro })\n\n  // Limpiar el formulario tras enviar\n  Object.assign(nuevoLibro, { titulo: '', autor: '', categoria: '', descripcion: '' })\n}\n</script>\n\n<style scoped>\n.formulario {\n  display: flex;\n  flex-direction: column;\n  gap: 0.8rem;\n  padding: 1.2rem;\n  border: 1px solid var(--linea);\n  border-radius: 8px;\n  background: var(--panel);\n  margin-bottom: 1.5rem;\n  font-family: sans-serif;\n}\n.campo { display: flex; flex-direction: column; gap: 0.3rem; }\n.campo label { font-size: 0.8rem; color: var(--texto-suave); }\n.campo input, .campo select, .campo textarea {\n  padding: 0.5rem;\n  border: 1px solid var(--linea);\n  border-radius: 6px;\n  font-family: inherit;\n  font-size: 0.9rem;\n}\n.campo input:focus, .campo select:focus, .campo textarea:focus {\n  outline: none;\n  border-color: var(--acento);\n  box-shadow: 0 0 0 2px var(--acento-suave);\n}\n.previa { font-size: 0.85rem; color: var(--acento-oscuro); margin: 0; }\n.btn-agregar {\n  align-self: flex-start;\n  padding: 0.5rem 1.2rem;\n  border: none;\n  border-radius: 6px;\n  background: var(--acento);\n  color: #fff;\n  cursor: pointer;\n}\n.btn-agregar:hover:not(:disabled) { background: var(--acento-oscuro); }\n.btn-agregar:disabled { background: #b1d5ff; cursor: not-allowed; }\n</style>\n"],"mappings":"AA6DA,SAASA,QAAQ,EAAEC,QAAQ,QAAQ,KAAI;;;;;;;;;IAEvC,MAAMC,IAAI,GAAGC,MAAA;;IAEb;IACA,MAAMC,UAAU,GAAGJ,QAAQ,CAAC;MAC1BK,MAAM,EAAE,EAAE;MACVC,KAAK,EAAE,EAAE;MACTC,SAAS,EAAE,EAAE;MACbC,WAAW,EAAE;IACf,CAAC;IAED,MAAMC,gBAAgB,GAAGR,QAAQ,CAAC,MAAM;MACtC,OAAOG,UAAU,CAACC,MAAM,CAACK,IAAI,CAAC,CAAC,KAAK,EAAE,IAAIN,UAAU,CAACE,KAAK,CAACI,IAAI,CAAC,CAAC,KAAK,EAAC;IACzE,CAAC;IAED,SAASC,MAAMA,CAAA,EAAG;MAChB,IAAI,CAACF,gBAAgB,CAACG,KAAK,EAAE;MAE7BV,IAAI,CAAC,eAAe,EAAE;QAAE,GAAGE;MAAW,CAAC;;MAEvC;MACAS,MAAM,CAACC,MAAM,CAACV,UAAU,EAAE;QAAEC,MAAM,EAAE,EAAE;QAAEC,KAAK,EAAE,EAAE;QAAEC,SAAS,EAAE,EAAE;QAAEC,WAAW,EAAE;MAAG,CAAC;IACrF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}